<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/preview_bg"
        android:padding="8dp">

        <ImageView
            android:id="@+id/designPreview"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/preview_desc" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Label"
                android:text="@string/label_bg" />

            <Spinner
                android:id="@+id/spinnerBg"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <Button
                android:id="@+id/btnPhoto"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pick_photo"
                android:visibility="gone" />

            <TextView
                style="@style/Label"
                android:text="@string/label_font" />

            <Spinner
                android:id="@+id/spinnerFont"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/Label"
                android:text="@string/label_size" />

            <Spinner
                android:id="@+id/spinnerSize"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/Label"
                android:text="@string/label_position" />

            <Spinner
                android:id="@+id/spinnerPosition"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/Label"
                android:text="@string/label_align" />

            <Spinner
                android:id="@+id/spinnerAlign"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchQuoteMark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/quote_mark"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_line"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnApplyDesign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/apply_design" />
</LinearLayout>
